# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Payment Gateway (Tripay / Midtrans) - Placeholder credentials for production
# Do NOT put real secrets in this example file. Put real secrets in .env.local (which is gitignored).
PAYMENT_GATEWAY_MODE=sandbox
TRIPAY_API_KEY=your_tripay_api_key_here
TRIPAY_PRIVATE_KEY=your_tripay_private_key_here
TRIPAY_MERCHANT_CODE=your_merchant_code_here
TRIPAY_CALLBACK_SECRET=your_callback_secret_here

# Google OAuth 2.0 Credentials (From Google Cloud Console)
# Put your real client ID and secret in .env.local (which is strictly gitignored)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
AUTH_SECRET=a_random_32_character_string_for_session_encryption

